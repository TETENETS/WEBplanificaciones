# Cadena de conexión a PostgreSQL con PostGIS
DATABASE_URL=postgres://fttx:fttx@localhost:5432/fttx
# true si la base exige SSL (p. ej. base gestionada externa)
DATABASE_SSL=false
PORT=3000
# Aplicar migraciones al arrancar (recomendado)
RUN_MIGRATIONS=true
# Cargar red de ejemplo si la base está vacía
SEED_DEMO=false
LOG_LEVEL=info
